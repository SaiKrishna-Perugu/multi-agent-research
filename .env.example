# Model provider: "groq" (default, free tier) or "vertexai"
MODEL_PROVIDER=groq
GROQ_API_KEY=gsk-your-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Only needed when MODEL_PROVIDER=vertexai
GCP_PROJECT_ID=
# Vertex model endpoint location; independent of the Cloud Run region.
GCP_LOCATION=global
VERTEX_CHAT_MODEL=gemini-3.5-flash

# Per-agent model overrides (optional -- feature-flag style). Leave blank
# to use the provider's default chat model for every agent.
RESEARCHER_MODEL_OVERRIDE=
ANALYST_MODEL_OVERRIDE=
WRITER_MODEL_OVERRIDE=

LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60

# Web search -- free key at https://app.tavily.com, no credit card required
TAVILY_API_KEY=tvly-your-key-here
MAX_SEARCH_RESULTS=5
SEARCH_DEPTH=basic
MAX_RESEARCH_QUERIES=4

# API auth (optional -- leave API_KEY blank to disable auth for local dev/demo)
API_KEY=
RATE_LIMIT=10/minute
CORS_ORIGINS=*

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research

REVIEW_TIMEOUT_MINUTES=60
 
# TypeSafe System One (optional -- intelligent judgement for citations, filtering, routing)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13
ENABLE_TYPESAFE=true
